@page "/"

<PageTitle>Melanoma Detection</PageTitle>

<div class="px-4 py-5 text-center">
    <h1 class="display-5 fw-bold">AI-Assisted Skin Lesion Analysis</h1>
    <div class="col-lg-8 mx-auto">
        <p class="lead mb-4">
            Upload a photo of a skin lesion and run it through an ABCDE-based image analysis
            pipeline to get a quick, informational risk read.
        </p>
        <a href="/upload" class="btn btn-primary btn-lg px-4">Start Analysis</a>
    </div>
</div>

<div class="container mb-4" style="max-width: 720px;">
    <div class="alert alert-danger" role="alert">
        <strong>DISCLAIMER:</strong> Educational use only.
        NOT a substitute for professional medical diagnosis.
        Consult a dermatologist.
    </div>

    <p class="text-center mb-0">
        Ready to check a lesion? <a href="/upload">Go to the Upload page</a>.
    </p>
</div>
